{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Harmonia lifecycle definition",
  "type": "object",
  "required": ["version", "stages"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "stages": {
      "type": "object",
      "required": ["ideate", "discuss", "plan", "implement", "review", "capture", "quick"],
      "additionalProperties": false,
      "properties": {
        "ideate": { "$ref": "#/definitions/stage" },
        "discuss": { "$ref": "#/definitions/stage" },
        "plan": { "$ref": "#/definitions/stage" },
        "implement": {
          "allOf": [
            { "$ref": "#/definitions/stage" },
            {
              "required": ["loop"],
              "properties": {
                "loop": {
                  "type": "object",
                  "required": ["type", "max_rounds"],
                  "additionalProperties": false,
                  "properties": {
                    "type": { "const": "red-green" },
                    "max_rounds": { "type": "integer", "minimum": 1 }
                  }
                }
              }
            }
          ]
        },
        "review": {
          "allOf": [
            { "$ref": "#/definitions/stage" },
            {
              "required": ["review"],
              "properties": {
                "review": {
                  "type": "object",
                  "required": ["mode", "panel", "lenses"],
                  "additionalProperties": false,
                  "properties": {
                    "mode": { "const": "panel" },
                    "panel": {
                      "type": "array",
                      "minItems": 1,
                      "items": { "$ref": "#/definitions/agentName" }
                    },
                    "lenses": {
                      "type": "array",
                      "minItems": 1,
                      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
                    }
                  }
                }
              }
            }
          ]
        },
        "capture": {
          "allOf": [
            { "$ref": "#/definitions/stage" },
            {
              "properties": {
                "agents": { "const": ["knowledge-curator", "committer"] }
              }
            }
          ]
        },
        "quick": {
          "allOf": [
            { "$ref": "#/definitions/stage" },
            {
              "required": ["review"],
              "properties": {
                "review": {
                  "type": "object",
                  "required": ["mode", "lenses"],
                  "additionalProperties": false,
                  "properties": {
                    "mode": { "const": "lead-solo" },
                    "lenses": {
                      "type": "array",
                      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
                    }
                  }
                }
              }
            }
          ]
        }
      }
    }
  },
  "definitions": {
    "agentName": {
      "enum": [
        "ideator", "scoper", "planner", "implementer", "test-engineer",
        "reviewer", "simplifier", "knowledge-curator", "committer",
        "doc-producer", "doc-reviewer", "rubber-duck"
      ]
    },
    "artifact": {
      "type": "object",
      "required": ["name", "location"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "location": { "type": "string", "pattern": "^(workspace:|docs/)" },
        "optional": { "type": "boolean" }
      }
    },
    "stage": {
      "type": "object",
      "required": ["purpose", "agents", "artifacts", "gates"],
      "properties": {
        "purpose": { "type": "string", "minLength": 1 },
        "entry": { "type": "boolean" },
        "agents": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/agentName" }
        },
        "artifacts": {
          "type": "object",
          "required": ["in", "out"],
          "additionalProperties": false,
          "properties": {
            "in": { "type": "array", "items": { "$ref": "#/definitions/artifact" } },
            "out": { "type": "array", "items": { "$ref": "#/definitions/artifact" } }
          }
        },
        "gates": {
          "type": "array",
          "items": { "enum": ["check-criteria", "coverage", "criteria-run", "receipts"] }
        },
        "loop": { "type": "object" },
        "review": { "type": "object" }
      }
    }
  }
}
